// Dedicated pipeline for CONTINUOUS PASSIVE monitoring of production.
//
// The heavy lifting runs ON THE PRODUCTION VM (deployed by Ansible in the main
// pipeline's Deploy stage): a native ZAP proxy daemon passively scans real
// traffic (nginx front door -> ZAP -> app), and a systemd reporter rebuilds the
// HTML report every 30s on the VM. Each build here fetches a RECENT SET of
// timestamped snapshots over SSH, then publishes an index page with links.
pipeline {
    agent any

    options {
        // Keep monitoring builds from piling up forever (this job fires often).
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    triggers {
        // The report itself is regenerated every 300s by the VM's zap-reporter
        // service; each build fetches multiple recent snapshots and publishes them.
        cron('H/15 * * * *')
    }

    stages {
        stage('Publish ZAP Passive Monitor Report') {
            steps {
                script {
                    load 'groovy/zap-monitoring.groovy'
                }
            }
        }
    }

    post {
        always {
            // Publish a job-level link that always opens the latest index page.
            publishHTML(target: [
                reportDir: 'zap/reports',
                reportFiles: 'index.html',
                reportName: 'ZAP Passive Monitoring Report',
                keepAll: false,
                allowMissing: true,
                alwaysLinkToLastBuild: true
            ])
            archiveArtifacts artifacts: 'zap/reports/*.html', allowEmptyArchive: true
        }
    }
}
